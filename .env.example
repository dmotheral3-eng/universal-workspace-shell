# Copy to .env and fill in. Never commit .env.
# Leave VITE_PROFILE unset (or blank) to use the default `workspace` profile on mock data.
# Profiles: (unset) = mock · lawdog = native Law Dog door · cube = master door +
# server broker · lending-app = the lending surface, master door + server broker.
#
# VITE_PROFILE IS INLINED AT BUILD TIME. One deployment serves exactly one
# profile; adding a config to the repo does not make an existing deployment
# serve it. A second surface is a SECOND hosting project built from this same
# repo with its own VITE_PROFILE — never a second panel inside the first.
VITE_PROFILE=

# --- Law Dog profile: its own native door (unchanged) ------------------------
VITE_LAWDOG_URL=
VITE_LAWDOG_ANON_KEY=

# --- cube profile: the master door -------------------------------------------
# Public by design. An anon key is what accompanies a user's own JWT, and both
# of these are inlined into the client bundle — correct for these two, and only
# for these two.
VITE_MASTER_URL=
VITE_MASTER_ANON_KEY=

# --- cube profile: the server broker (/api/cube/*) ----------------------------
# SERVER ONLY. Set in the hosting project by hand, never in a client build, and
# NEVER under a VITE_ prefix — Vite inlines every VITE_* value into the browser
# bundle. The broker refuses to boot if it finds one of these republished as a
# VITE_ variable. See ARCHITECTURE.md, "The door".
MASTER_URL=
MASTER_ANON_KEY=
CUBE_URL=
CUBE_BROKER_KEY=
# Optional; defaults to shell_tenant_members
SHELL_MEMBERSHIP_TABLE=

# --- lending-app profile ------------------------------------------------------
# Adds NO new variable. It uses exactly the four client values and four server
# values above: the same master door, the same broker, the same credential
# names. What differs is VITE_PROFILE=lending-app and the tenancy row behind the
# caller — the broker narrows lending reads to the books master says they hold,
# on top of the tenant filter every resource already carries.

# --- search-engine gate (D-NOINDEX-1) -----------------------------------------
# Every profile built from index.html (lawdog, cube, lending-app) shares this
# flag. LEAVE UNSET while the surface is status='building' in project_routing —
# ABSENT IS THE SAFE DEFAULT: build-plugins/public-surface-gate-plugin.ts emits
# a real dist/robots.txt with Disallow: / and a noindex meta tag, so the SPA
# rewrite in vercel.json can never accidentally serve index.html for a crawler
# asking for directives. Set VITE_PUBLIC_LAUNCH=true in the hosting project's
# env ONLY once that specific surface is meant to be found by search engines —
# a code change is never how a surface goes public, an env flip is.
VITE_PUBLIC_LAUNCH=

# --- /api/whereweare: the universal where-are-we ladder --------------------------
# SERVER ONLY, and NEVER under a VITE_ prefix. Reuses MASTER_URL / MASTER_ANON_KEY
# above -- the ladder registry on master is read with the CALLER's own token, so
# this route holds no master secret of its own.
#
# WHEREWEARE_SOURCE_KEYS is a JSON object mapping a Supabase project ref to a read
# credential for it: {"rmsafbcpzyxywekygevu":"<key>"}
# A ref with no entry is not an error -- that vertical's ladder comes back with
# note "no_source_credential" and NULL counts, and the board renders it RED. A
# missing credential is always visible, never a silent zero.
WHEREWEARE_SOURCE_KEYS=
